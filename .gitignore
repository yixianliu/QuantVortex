# 早期清理数据时误建的临时目录（里面只剩 SQLite 的 shm/wal 残留）
remove data/

# ================= 测试 / 运行期产物（不入库）=================
# 跑测与运行时吐出来的副产物，跟着核心资产一起入库会把仓库淹没。
# 注意：gitignore 的 **行尾 # 不是注释**，是模式的一部分（只有行首 # 才是），
# 所以每条规则必须独占一行、注释另起一行写，否则规则会静默失配。
tests/_*.xml
tests/_*.txt
tests/_*.out
tests/e2e/archived_logs/
tests/e2e/*.png
outputs/

# 安全删除守卫的探针文件（utils/redact 与 storage 会反复 touch）
.write_test

# 自动进化与新闻缓存：每次进化都会重写，属于运行时数据（沿用 data/sina_cache/ 口径）
data/evolution/
data/auto_strategies/
data/cls_news_cache.json
data/_pred_export.csv

