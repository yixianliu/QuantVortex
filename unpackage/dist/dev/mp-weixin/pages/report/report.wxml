<view class="container"><view class="header"><view class="header-content"><view class="back-btn" bindtap="{{a}}"><text>←</text></view><text class="header-title">{{b}}</text><view class="placeholder"></view></view><view wx:if="{{c}}" class="vip-badge">VIP会员</view></view><view wx:if="{{d}}" class="report-content"><view wx:if="{{e}}" class="report-inner"><view class="report-header"><view class="header-info"><text class="report-type">{{f}}</text><text class="generate-time">GENERATED: {{g}}</text></view><view class="{{['report-badge', i]}}">{{h}}</view></view><view class="summary-card"><text class="card-title">📊 DATA SUMMARY</text><view class="summary-grid"><view class="summary-item"><text class="summary-value">{{j}}</text><text class="summary-label">TOTAL</text></view><view class="summary-item"><text class="summary-value">{{k}}</text><text class="summary-label">ANALYZED</text></view><view class="summary-item"><text class="summary-value">{{l}}%</text><text class="summary-label">ACCURACY</text></view><view class="summary-item"><text class="summary-value">{{m}}%</text><text class="summary-label">CONFIDENCE</text></view></view></view><view class="analysis-card"><text class="card-title">🔥 HOT NUMBERS</text><view class="analysis-content"><view class="number-list hot"><view wx:for="{{n}}" wx:for-item="item" wx:key="d" class="number-item"><view class="number-circle">{{item.a}}</view><view class="number-info"><text class="number-count">FREQ: {{item.b}}</text><text class="number-rate">{{item.c}}%</text></view></view></view></view></view><view class="analysis-card"><text class="card-title">❄️ COLD NUMBERS</text><view class="analysis-content"><view class="number-list cold"><view wx:for="{{o}}" wx:for-item="item" wx:key="d" class="number-item"><view class="number-circle">{{item.a}}</view><view class="number-info"><text class="number-count">FREQ: {{item.b}}</text><text class="number-rate">{{item.c}}%</text></view></view></view></view></view><view class="distribution-card"><text class="card-title">📈 DISTRIBUTION</text><view class="dist-section"><text class="dist-title">ODD / EVEN</text><view class="dist-chart"><view class="dist-bar-wrapper"><view class="dist-bar odd" style="{{'width:' + p}}"></view><view class="dist-bar even" style="{{'width:' + q}}"></view></view><view class="dist-labels"><text>ODD {{r}}%</text><text>EVEN {{s}}%</text></view></view></view><view class="dist-section"><text class="dist-title">SMALL / LARGE</text><view class="dist-chart"><view class="dist-bar-wrapper"><view class="dist-bar small" style="{{'width:' + t}}"></view><view class="dist-bar large" style="{{'width:' + v}}"></view></view><view class="dist-labels"><text>SMALL {{w}}%</text><text>LARGE {{x}}%</text></view></view></view></view><view class="recommend-card"><view class="card-header"><text class="card-title">🎯 RECOMMENDED</text><text class="recommend-tip">ANALYSIS RESULT</text></view><view class="recommend-numbers"><block wx:if="{{y}}"><view class="num-group"><text class="group-label">GROUP 1</text><view class="num-row"><view wx:for="{{z}}" wx:for-item="num" wx:key="b" class="num-box primary">{{num.a}}</view></view></view><view class="num-group"><text class="group-label">GROUP 2</text><view class="num-row"><view class="num-box secondary">{{A}}</view></view></view></block><block wx:elif="{{B}}"><view class="num-group"><text class="group-label">GROUP 1</text><view class="num-row"><view wx:for="{{C}}" wx:for-item="num" wx:key="b" class="num-box primary">{{num.a}}</view></view></view><view class="num-group"><text class="group-label">GROUP 2</text><view class="num-row"><view wx:for="{{D}}" wx:for-item="num" wx:key="b" class="num-box secondary">{{num.a}}</view></view></view></block><block wx:elif="{{E}}"><view class="num-group"><text class="group-label">TRIPLE CODE</text><view class="num-row"><view class="triple-num-box"><text class="triple-label">H</text><view class="num-box triple">{{F}}</view></view><view class="triple-num-box"><text class="triple-label">T</text><view class="num-box triple">{{G}}</view></view><view class="triple-num-box"><text class="triple-label">U</text><view class="num-box triple">{{H}}</view></view></view></view></block></view></view><view class="strategy-card"><text class="card-title">💡 STRATEGY</text><view class="strategy-content"><view wx:for="{{I}}" wx:for-item="item" wx:key="d" class="strategy-item"><view class="strategy-icon">{{item.a}}</view><view class="strategy-info"><text class="strategy-title">{{item.b}}</text><text class="strategy-desc">{{item.c}}</text></view></view></view></view></view><view wx:else class="loading-state"><text class="loading-text">LOADING DATA...</text></view><view class="footer-space"></view></view><view wx:else class="no-access-content"><view class="access-denied-card"><view class="access-icon">🔒</view><text class="access-title">权限不足</text><text class="access-desc">{{J}}</text><view class="access-actions"><button wx:if="{{K}}" class="access-btn primary" bindtap="{{L}}"><text class="btn-icon">🔐</text><text class="btn-text">立即登录</text></button><button wx:else class="access-btn primary" bindtap="{{M}}"><text class="btn-icon">💎</text><text class="btn-text">升级VIP</text></button><button class="access-btn secondary" bindtap="{{N}}"><text class="btn-text">返回首页</text></button></view></view></view><view wx:if="{{O}}" class="bottom-actions"><view class="action-btn copy" bindtap="{{P}}"><text class="btn-icon">📋</text><text class="btn-text">COPY</text></view><view class="action-btn share" bindtap="{{Q}}"><text class="btn-icon">📤</text><text class="btn-text">SHARE</text></view></view><login-modal wx:if="{{T}}" bindclose="{{R}}" bindloginSuccess="{{S}}" u-i="dc72019a-0" bind:__l="__l" u-p="{{T}}"/><payment-modal wx:if="{{W}}" bindclose="{{U}}" bindpaySuccess="{{V}}" u-i="dc72019a-1" bind:__l="__l" u-p="{{W}}"/></view>