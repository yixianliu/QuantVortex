/* @generated */

/* ===== 基础 ===== */
QWidget { background:#1e1e2e; color:#dcdcdc; font-family:'SimHei','Noto Sans SC','Microsoft YaHei',sans-serif; }
QMainWindow { background:#1e1e2e; }
QWidget#central { background:#1e1e2e; }
QWidget#content-panel { background:#1e1e2e; }
QFrame#toolbar { background:#181825; border:1px solid #45455f; border-radius:10px; }
QFrame#hsep { background:#2a2a3a; border:none; }

/* ===== 侧边导航 ===== */
QListWidget#nav { background:#181825; border:none; padding-top:10px; padding-bottom:10px; outline:0; }
QListWidget#nav::item { color:#8b93a7; padding:12 16; border-left:3px solid transparent; margin:2px 8px; border-radius:8px; }
QListWidget#nav::item:hover { background:#27273a; color:#dcdcdc; }
QListWidget#nav::item:selected { background:#27273a; color:#dcdcdc; border-left:3px solid #7aa2f7; }

/* ===== 内容区 ===== */
QStackedWidget { background:#1e1e2e; }

/* ===== UX-61: 页面头部 ===== */
QFrame#page-header { background:#181825; border-bottom:1px solid #45455f; }
QLabel#breadcrumb { color:#dcdcdc; font-weight:600; }
QLabel#breadcrumb-sep { color:#8b93a7; }
QLabel#page-subtitle { color:#8b93a7; }

/* ===== 文本 ===== */
QLabel { color:#dcdcdc; background:transparent; }
QLabel#sub { color:#8b93a7; }

/* ===== 按钮 ===== */
QPushButton { background:#7aa2f7; color:#fff; border:1px solid transparent; border-radius:8px; padding:8px 18px; font-size:12px; font-weight:bold; }
QPushButton:hover { background:#3b82f6; border-color:#7aa2f7; }
QPushButton:pressed { background:#3b82f6; padding-top:9px; padding-bottom:7px; }
QPushButton:focus { border:1px solid #3b82f6; outline:none; }
QPushButton:disabled { background:#181825; color:#8b93a7; border-color:transparent; }
QPushButton#secondary { background:#27273a; color:#dcdcdc; border:1px solid #45455f; font-weight:500; }
QPushButton#secondary:hover { background:#181825; border-color:#45455f; color:#dcdcdc; }
QPushButton#secondary:pressed { background:#181825; }
QPushButton#secondary:focus { border-color:#3b82f6; }
QPushButton#primary { background:#7aa2f7; }
QPushButton#primary:hover { background:#3b82f6; }
QPushButton#danger { background:#dc2626; }
QPushButton#danger:hover { background:#b91c1c; }
QPushButton#danger:pressed { background:#991b1b; }

/* ===== 输入控件 ===== */
QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit { background:#27273a; border:1px solid #45455f; border-radius:8px; padding:6px 10px; color:#dcdcdc; font-size:12px; selection-background-color:#7aa2f7; selection-color:#fff; }
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover { border-color:#45455f; }
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus { border:1px solid #3b82f6; background:#27273a; }
QComboBox::drop-down { border:none; width:20px; }
QComboBox QAbstractItemView { background:#27273a; color:#dcdcdc; selection-background-color:#7aa2f7; selection-color:#fff; border:1px solid #45455f; border-radius:8px; outline:0; padding:4px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { width:16px; border:none; background:transparent; }
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover { background:#181825; }

/* ===== 表格 ===== */
QTableWidget { background:#27273a; gridline-color:#2a2a3a; border:1px solid #45455f; border-radius:10px; outline=0; font-size:11px; }
QTableWidget::item { padding:6px 8px; border:none; }
QTableWidget::item:selected { background:#7aa2f7; color:#fff; }
QHeaderView::section { background:#181825; color:#8b93a7; border:none; padding:8px; font-weight:bold; font-size:11px; }
QHeaderView::section:hover { color:#dcdcdc; }
QTableWidget::item:hover { background:#27273a; }

/* ===== 标签页 ===== */
QTabWidget::pane { border:1px solid #45455f; border-radius:10px; top:-1px; }
QTabBar::tab { background:#181825; color:#8b93a7; padding:9px 16px; margin-right:6px; border-top-left-radius:8px; border-top-right-radius:8px; }
QTabBar::tab:selected { background:#27273a; color:#dcdcdc; }
QTabBar::tab:hover { color:#dcdcdc; }

/* ===== UX-62: 顶部 Tab 导航 ===== */
QTabWidget#top-tabs { background:#181825; border-bottom:1px solid #45455f; }
QTabWidget#top-tabs::pane { border:none; top:0; }
QTabWidget#top-tabs > QTabBar::tab { background:transparent; color:#8b93a7; padding:6px 12px; margin-right:2px; border-radius:8px; }
QTabWidget#top-tabs > QTabBar::tab:selected { background:#7aa2f7; color:#fff; }
QTabWidget#top-tabs > QTabBar::tab:hover { background:#27273a; color:#dcdcdc; }

/* ===== 滚动条 ===== */
QScrollBar:vertical { background:#1e1e2e; width:12px; border-radius:6px; margin=0; }
QScrollBar::handle:vertical { background:#45455f; border-radius:6px; min-height:32px; margin:1px; }
QScrollBar::handle:vertical:hover { background:#8b93a7; }
QScrollBar::handle:vertical:pressed { background:#7aa2f7; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height=0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background:transparent; }
QScrollBar:horizontal { background:#1e1e2e; height:12px; border-radius:6px; margin=0; }
QScrollBar::handle:horizontal { background:#45455f; border-radius:6px; min-width:32px; margin:1px; }
QScrollBar::handle:horizontal:hover { background:#8b93a7; }
QScrollBar::handle:horizontal:pressed { background:#7aa2f7; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width=0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background:transparent; }

/* ===== 复选框 ===== */
QCheckBox { color:#dcdcdc; spacing:8px; background:transparent; }
QCheckBox::indicator { width:16px; height:16px; border-radius:4px; border:1px solid #45455f; background:#27273a; }
QCheckBox::indicator:hover { border-color:#7aa2f7; }
QCheckBox::indicator:checked { background:#7aa2f7; border-color:#7aa2f7; }
QCheckBox::indicator:checked:hover { background:#3b82f6; }

/* ===== 菜单栏 / 菜单 ===== */
QMenuBar { background:#181825; color:#dcdcdc; padding:3px 6px; border-bottom:1px solid #45455f; spacing:2px; }
QMenuBar::item { background=transparent; padding:6px 14px; border-radius:6px; }
QMenuBar::item:selected { background:#7aa2f7; color:#fff; }
QMenuBar::item:pressed { background:#3b82f6; }
QMenu { background:#27273a; color:#dcdcdc; border:1px solid #45455f; border-radius:10px; padding:6px; }
QMenu::item { padding:8px 26px 8px 14px; border-radius:6px; }
QMenu::item:selected { background:#7aa2f7; color:#fff; }
QMenu::separator { height:1px; background:#45455f; margin:5px 12px; }

/* ===== 状态栏 ===== */
QStatusBar { background:#181825; color:#8b93a7; border-top:1px solid #45455f; padding:5px 12px; }
QStatusBar::item { border:none; }
#status-dot { color:#ff4757; font-weight:bold; font-size:12px; }
#status-ver { color:#3b82f6; font-weight:bold; font-size:12px; padding=0 8px; }
QFrame#chip { border-radius:12px; }

/* ===== 设计系统选择器（M4-04 单一事实来源） ===== */
QFrame#card { background:#27273a; border:1px solid #45455f; border-radius:10px; }
QFrame#ai-group { background:#181825; border:1px solid #45455f; border-radius:10px; }
QWidget#btn-bar, QFrame#btn-bar { background:transparent; spacing:8px; }
QGroupBox#primary { border:1px solid #7aa2f7; border-radius:10px; }
QWidget#secondary { background:#181825; }

QToolTip { background:#181825; color:#dcdcdc; border:1px solid #45455f; border-radius:6px; padding:5px 8px; }

/* ===== 焦点可见样式（UX-74：键盘导航可辨识） ===== */
/* 通用焦点环：2px 圆角描边，仅键盘导航时显示 */
QPushButton:focus-visible { border:2px solid #3b82f6; outline:none; }
QComboBox:focus-visible, QSpinBox:focus-visible, QDoubleSpinBox:focus-visible, QLineEdit:focus-visible { border:2px solid #3b82f6; outline:none; }
QTableWidget:focus-visible { border:2px solid #3b82f6; }
QListWidget:focus-visible { border:2px solid #3b82f6; }
QTreeWidget:focus-visible, QTreeView:focus-visible, QListView:focus-visible { border:2px solid #3b82f6; }
QCheckBox:focus-visible, QRadioButton:focus-visible { outline:2px solid #3b82f6; border-radius:8px; }
QSlider::handle:focus-visible { border:2px solid #3b82f6; }
QScrollBar::handle:focus-visible { background:#3b82f6; }
QMenu:focus-visible { border:1px solid #3b82f6; }
QDialog:focus-visible { border:1px solid #3b82f6; }
QLineEdit:focus-visible { border:2px solid #3b82f6; }
QTextEdit:focus-visible, QPlainTextEdit:focus-visible { border:2px solid #3b82f6; }
QListWidget#nav:focus { border:none; }
QListWidget#nav::item:focus { background:#27273a; color:#dcdcdc; border-left:3px solid #3b82f6; }
QTabBar::tab:focus { color:#dcdcdc; border:1px solid #3b82f6; border-bottom:none; }
QTabBar::tab:focus-visible { color:#dcdcdc; border:2px solid #3b82f6; border-bottom:none; }
