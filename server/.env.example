# QuantVortex AI 代理服务 —— 环境变量样例
#
# 用法：复制为 .env 后填入真实值，用 systemd / supervisor / docker 注入进程环境。
# 严禁把填好真实值的文件提交进仓库、打进镜像层或随客户端分发。
# .env 应当写进 .gitignore。

# ---------------------------------------------------------------- 必填
# 上游 chat/completions 的 base（不含 /chat/completions 后缀）
QV_UPSTREAM_BASE=https://apihub.example.com/v1

# 上游真实密钥 —— 只存在于服务器，永不下发客户端
QV_UPSTREAM_KEY=<在此填入上游密钥>

# 签发客户端短期令牌用的服务端密钥，至少 16 字符
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 轮换此值会令所有已签发的客户端令牌立即失效（应急止损手段）
QV_JWT_SECRET=<在此填入随机长字符串>

# ---------------------------------------------------------------- 密钥轮换
# 平滑轮换期间的旧密钥；仅在主密钥鉴权失败时兜底。
# 轮换收尾后请清空本项并重启（详见 docs/security_architecture.md 第四节）
QV_UPSTREAM_KEY_OLD=

# ---------------------------------------------------------------- 建议填
# 随客户端分发的应用级 key。注意：它可被逆向提取，只是一道低强度门槛，
# 不要把它当作安全核心。留空则任何人都能注册设备。
QV_APP_RELEASE_KEY=<在此填入应用级 key>

# 管理接口令牌（/v1/admin/*）。留空则管理接口直接返回 404。
QV_ADMIN_TOKEN=<在此填入管理员令牌>

# 上游模型与白名单（白名单为空表示不限制）
QV_UPSTREAM_MODEL=agnes-2.0-flash
QV_ALLOWED_MODELS=agnes-2.0-flash

# ---------------------------------------------------------------- 可选调参
QV_JWT_TTL=3600            # 客户端令牌有效期（秒）
QV_RATE_PER_MIN=20         # 每设备稳态速率
QV_RATE_BURST=5            # 每设备突发容量
QV_UPSTREAM_TIMEOUT=30     # 上游请求超时（秒）
QV_MAX_PROMPT_CHARS=12000  # 单次请求 system+user 字符上限
