#!/bin/sh
# QuantVortex pre-commit 钩子：只扫**暂存的改动**（非全量），秒级。
# 两关（任一非 0 即阻断提交）：
#   1) 密钥扫描  secret_scan.py      —— 暂存文件里不得出现硬编码密钥
#   2) 静默失效  scan_silent_bail.py —— 暂存 .py 里不得引入「未留痕 high CHAIN」
# 逃生口：QV_SKIP_HOOKS=1 git commit 可整体跳过（用于紧急/历史批量提交）。
# 解释器缺失时 fail-open（放行并警告）：钩子不能变成「谁都提交不了」的卡子。

# 逃生口
if [ -n "${QV_SKIP_HOOKS:-}" ] && [ "${QV_SKIP_HOOKS}" != "0" ]; then
    echo "[pre-commit] QV_SKIP_HOOKS 已设置，跳过质量钩子"
    exit 0
fi

# 取暂存文件（新增/复制/修改/重命名；不含删除）
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
    exit 0   # 没有改动（例如仅改提交信息），直接放行
fi

# 定位解释器：优先 python，找不到就放行并警告（fail-open）
python_cmd=""
for cand in python python3 /d/anaconda3/python.exe /c/Users/Administrator/.workbuddy/binaries/python/versions/3.13.12/python.exe; do
    if command -v "$cand" >/dev/null 2>&1; then
        python_cmd="$cand"; break
    fi
    if [ -x "$cand" ]; then
        python_cmd="$cand"; break
    fi
done
if [ -z "$python_cmd" ]; then
    echo "[pre-commit] ⚠️ 找不到 python，无法跑质量钩子 —— 放行本次提交，请手动 python tools/check.py"
    exit 0
fi

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

# 关键：让扫描器别打印 sitecustomize 的 [DLL固定] banner 干扰终端，
# 且不写 .pytest_tmp（钩子不该污染项目临时目录）。
export QV_NO_BANNER=1
fail=0

# ---------- 关 1：密钥扫描（全部暂存文件）----------
echo "[pre-commit] ① 密钥扫描（$([ -n "$staged" ] && echo 暂存改动)）"
$python_cmd build_tools/secret_scan.py -- $staged
sc=$?
if [ $sc -ne 0 ]; then
    echo "[pre-commit] ❌ 密钥扫描未通过（exit=$sc）。确认为误报可用 QV_SKIP_HOOKS=1 强制提交。"
    fail=1
fi

# ---------- 关 2：静默失效（仅暂存的 .py）----------
pyfiles=$(printf '%s\n' $staged | grep -E '\.py$' || true)
if [ -n "$pyfiles" ]; then
    echo "[pre-commit] ② 静默失效扫描（$pyfiles）"
    # 只传暂存的 .py 文件，秒级；--min-severity high 使「未留痕 high」才阻断
    $python_cmd tools/scan_silent_bail.py --dir $pyfiles --min-severity high --format text
    sb=$?
    if [ $sb -ne 0 ]; then
        echo "[pre-commit] ❌ 引入了未留痕的静默失效（except 钉 None → 静默 return）。"
        echo "   修法：补 logger 留痕，或加「# scan-silent-bail: 允许 —— 理由」豁免。"
        fail=1
    fi
else
    echo "[pre-commit] ② 静默失效扫描（无暂存 .py，跳过）"
fi

# ---------- 汇总 ----------
if [ $fail -ne 0 ]; then
    echo "[pre-commit] 提交被阻断。修复后重跑；或用 QV_SKIP_HOOKS=1 绕过。"
    exit 1
fi
echo "[pre-commit] ✅ 质量钩子通过"
exit 0
